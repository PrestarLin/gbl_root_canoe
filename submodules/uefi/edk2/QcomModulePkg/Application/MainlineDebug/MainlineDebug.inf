#/* @file
#  Debug sibling of SfbKernelBoot: start a Linux kernel the way ABL does, but
#  from the recovery_a partition reformatted as FAT16, with the trio and the
#  logs in \kb -- the lingxv flow with recovery_b renamed to recovery_a.
#
#  The log probe on that volume is mandatory: this build exists so last.txt
#  and klog.txt can be written and read back, so a read-only volume is the
#  wrong volume.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#*/

[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = mainlinedebug
  FILE_GUID                      = 752aacb2-8659-4f07-9b06-2595a9f60886
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = SfbKernelBootEntry

[Sources]
  mainlinedebug.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  # For gEfiPartitionRecordGuid, the GPT entry the platform publishes per
  # partition. The BDS uses the same GUID to find its logfs volume.
  QcomModulePkg/QcomModulePkg.dec

[LibraryClasses]
  ArmLib
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  # The package builds with -fstack-protector-all, so these two symbols have to
  # come from somewhere; LinuxLoader and MuChain link the same library.
  StackCanary
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  # Block I/O is what the search enumerates.
  gEfiBlockIoProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  # Carries EFI_PARTITION_ENTRY, whose PartitionName identifies the volume.
  # Declared under [Protocols] in QcomModulePkg.dec despite the name.
  gEfiPartitionRecordGuid
  # Only the handoff canary uses this: the frame buffer it draws to.
  gEfiGraphicsOutputProtocolGuid

[Guids]
  gEfiFileInfoGuid

[Depex]
  TRUE
